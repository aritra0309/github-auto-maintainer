 import pytest
+import time
 import jwt
 
+
 def test_validate_token():
     token = create_token({"sub": "user1"})
     result = validate_token(token)
     assert result["sub"] == "user1"
+
+
+def test_validate_token_none():
+    with pytest.raises(ValueError, match="cannot be None"):
+        validate_token(None)
+
+
+def test_validate_token_not_string():
+    with pytest.raises(TypeError, match="must be a string"):
+        validate_token(12345)
+
+
+def test_validate_token_too_long():
+    with pytest.raises(ValueError, match="exceeds maximum"):
+        validate_token("x" * 10001)
+
+
+def test_validate_token_missing_exp():
+    token = jwt.encode({"sub": "user1"}, SECRET_KEY)
+    with pytest.raises(ValueError, match="missing expiration"):
+        validate_token(token)
+
+
+def test_validate_token_expired():
+    token = jwt.encode({"sub": "user1", "exp": 0, "iat": 0}, SECRET_KEY)
+    with pytest.raises(TokenExpiredError):
+        validate_token(token)
+
+
+def test_validate_token_future_iat():
+    token = jwt.encode({"sub": "user1", "exp": time.time() + 3600, "iat": time.time() + 3600}, SECRET_KEY)
+    with pytest.raises(ValueError, match="issued in the future"):
+        validate_token(token)
+
+
+def test_validate_token_invalid_audience():
+    token = jwt.encode({"sub": "user1", "exp": time.time() + 3600, "iat": time.time(), "aud": "wrong"}, SECRET_KEY)
+    with pytest.raises(ValueError, match="Invalid audience"):
+        validate_token(token)
+
+
+def test_create_token_default_ttl():
+    token = create_token({"sub": "user1"})
+    decoded = jwt.decode(token, SECRET_KEY, algorithms=["HS256"], audience=EXPECTED_AUDIENCE)
+    assert decoded["sub"] == "user1"
+    assert decoded["aud"] == EXPECTED_AUDIENCE
+
+
 def test_revoke_token():
     token = create_token({"sub": "user1", "jti": "abc123"})
     assert revoke_token(token) is True
     assert is_token_revoked(token) is True
+
+
+def test_revoke_token_missing_jti():

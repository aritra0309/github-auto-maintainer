+"""Request middleware for logging and rate limiting."""
+
+import logging
+import time
+from collections import defaultdict
+
+logger = logging.getLogger(__name__)
+
+REQUEST_COUNTS: dict[str, list[float]] = defaultdict(list)
+RATE_LIMIT_WINDOW = 60
+RATE_LIMIT_MAX = 100
+
+
+def rate_limit_middleware(request, call_next):
+    client_ip = request.client.host
+    now = time.time()
+    REQUEST_COUNTS[client_ip] = [
+        t for t in REQUEST_COUNTS[client_ip] if t > now - RATE_LIMIT_WINDOW
+    ]
+    if len(REQUEST_COUNTS[client_ip]) >= RATE_LIMIT_MAX:
+        return {"error": "Rate limit exceeded"}, 429
+    REQUEST_COUNTS[client_ip].append(now)
+    return call_next(request)
+
+
+def logging_middleware(request, call_next):
+    start = time.time()
+    response = call_next(request)
+    elapsed = time.time() - start
+    logger.info(
+        "method=%s path=%s status=%s elapsed=%.3fs",
+        request.method,
+        request.url.path,
+        getattr(response, "status_code", "?"),
+        elapsed,
+    )
+    return response
+
+
+def error_handler(request, exc):
+    logger.exception("Unhandled error: %s", exc)
+    return {"error": "Internal server error"}, 500

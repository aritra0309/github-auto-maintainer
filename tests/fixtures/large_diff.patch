+"""HTTP route handlers."""
+
+import logging
+from functools import wraps
+
+logger = logging.getLogger(__name__)
+
+
+def require_auth(f):
+    @wraps(f)
+    def wrapper(*args, **kwargs):
+        token = request.headers.get("Authorization")
+        if token is None:
+            return {"error": "Missing token"}, 401
+        try:
+            decoded = validate_token(token)
+        except Exception as e:
+            return {"error": str(e)}, 401
+        request.user = decoded
+        return f(*args, **kwargs)
+    return wrapper
+
+
+def require_admin(f):
+    @wraps(f)
+    def wrapper(*args, **kwargs):
+        if not getattr(request, "user", {}).get("role") == "admin":
+            return {"error": "Admin required"}, 403
+        return f(*args, **kwargs)
+    return wrapper
+
+
 def login():
     user = authenticate(request.json)
     token = create_token(user)
+    logger.info("User logged in: %s", user.get("sub"))
     return {"token": token}
 
+
+def logout():
+    token = request.headers.get("Authorization")
+    if token is None:
+        return {"error": "Missing token"}, 401
+    try:
+        revoke_token(token)
+    except ValueError as e:
+        return {"error": str(e)}, 400
+    return {"status": "logged out"}
+
+
+@require_auth
+def whoami():
+    return {"user": request.user["sub"], "role": request.user.get("role", "user")}

diff --git a/tests/test_auth.py b/tests/test_auth.py
index eeeeeee..fffffff 100644
--- a/tests/test_auth.py
+++ b/tests/test_auth.py
@@ -10,3 +10,30 @@ def test_validate_token():
     token = create_token({"sub": "user1"})
     result = validate_token(token)
     assert result["sub"] == "user1"
+
+def test_validate_token_missing_exp():
+    token = jwt.encode({"sub": "user1"}, SECRET_KEY)
+    with pytest.raises(ValueError, match="missing expiration"):
+        validate_token(token)
+
+def test_validate_token_expired():
+    token = jwt.encode({"sub": "user1", "exp": 0, "iat": 0}, SECRET_KEY)
+    with pytest.raises(TokenExpiredError):
+        validate_token(token)
+
+def test_revoke_token():
+    token = create_token({"sub": "user1", "jti": "abc123"})
+    assert revoke_token(token) is True
+    assert is_token_revoked(token) is True
+
+def test_revoke_token_missing_jti():
+    token = create_token({"sub": "user1"})
+    with pytest.raises(ValueError, match="missing JTI"):
+        revoke_token(token)
+
+def test_is_token_revoked_no_jti():
+    token = create_token({"sub": "user1"})
+    assert is_token_revoked(token) is False
+
+def test_is_token_revoked_not_revoked():
+    token = create_token({"sub": "user1", "jti": "fresh123"})
+    assert is_token_revoked(token) is False

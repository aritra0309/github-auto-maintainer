# GitHub App ID (from https://github.com/settings/apps after creating your app)
GITHUB_APP_ID=

# GitHub App private key path (PEM file downloaded from your GitHub App settings)
GITHUB_APP_PRIVATE_KEY_PATH=

# GitHub webhook secret (set in GitHub App webhook config)
GITHUB_WEBHOOK_SECRET=

# Anthropic API key (create at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# xAI/Grok API key (create from your xAI developer account dashboard)
GROK_API_KEY=

# Ollama base URL (local by default)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Runtime defaults read by the model router
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini

# Optional absolute/relative override for model catalog file
# MODEL_CATALOG_PATH=config/models.yaml

# Phase 4: Write action controls
DRY_RUN=true
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_ALLOWED_EVENTS=

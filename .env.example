# GitHub App ID (from https://github.com/settings/apps after creating your app)
GITHUB_APP_ID=

# GitHub App private key path (PEM file downloaded from your GitHub App settings)
GITHUB_APP_PRIVATE_KEY_PATH=

# GitHub webhook secret (set in GitHub App webhook config)
GITHUB_WEBHOOK_SECRET=

# --- LLM Provider API Keys ---
# Setting an API key automatically enables that provider's models via auto-discovery.
# Only set the keys for providers you actually use. At least one is required.

# Anthropic API key (create at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google / Gemini API key (create at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# xAI/Grok API key (create from your xAI developer account dashboard)
# NOTE: LiteLLM expects XAI_API_KEY (not GROK_API_KEY)
XAI_API_KEY=

# OpenRouter API key (create at https://openrouter.ai/keys)
# One key unlocks access to hundreds of models through the OpenRouter aggregator.
OPENROUTER_API_KEY=

# NVIDIA NIM API key (create at https://build.nvidia.com/)
# One key unlocks access to NVIDIA-hosted models.
NVIDIA_NIM_API_KEY=

# Ollama base URL (local by default)
# NOTE: LiteLLM expects OLLAMA_API_BASE (not OLLAMA_BASE_URL)
OLLAMA_API_BASE=http://localhost:11434

# --- Runtime Defaults (optional) ---
# If set, these act as preference hints for routing. If not set, the system
# picks the best available model automatically via auto-discovery.
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# Phase 4: Write action controls
DRY_RUN=true
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_ALLOWED_EVENTS=

# Phase 5: Auto-fix pipeline
RUN_STORE_PATH=runs.db
AUTO_FIX_ENABLED=true
AUTO_FIX_TRIGGER_LABEL=auto-fix
AUTO_FIX_TRIGGER_COMMAND=/auto-fix

# Phase 6: Logging & Observability
# "json" for production (default), "dev" for coloured local console output
LOG_FORMAT=json

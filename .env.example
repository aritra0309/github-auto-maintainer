# GitHub App ID (from https://github.com/settings/apps after creating your app)
GITHUB_APP_ID=

# GitHub App private key path (PEM file downloaded from your GitHub App settings)
GITHUB_APP_PRIVATE_KEY_PATH=

# GitHub webhook secret (set in GitHub App webhook config)
GITHUB_WEBHOOK_SECRET=

# Anthropic API key (create at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# xAI/Grok API key (create from your xAI developer account dashboard)
GROK_API_KEY=
